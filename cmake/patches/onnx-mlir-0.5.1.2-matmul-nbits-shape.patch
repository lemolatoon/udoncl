+        bool hasGivenType = i < givenOutputTypes.size() &&
+                            isa<TensorType>(givenOutputTypes[i]);
+        if ((!options_.useOnnxModelTypes && !hasGivenType) ||
+            isa<NoneType>(result.getType()))
           result.setType(outTypes[i]);
       }
     }
@@ -1456,7 +1462,24 @@ private:
     int nOut = 0;
     getNodeInputs(node, inputs);
     nOut = node.output().size();
+    if (node.domain() == "com.microsoft" && opName == "MatMulNBits" &&
+        inputs.size() >= 1) {
+      if (auto inputType = mlir::dyn_cast<RankedTensorType>(inputs[0].getType())) {
+        int64_t outputColumns = -1;

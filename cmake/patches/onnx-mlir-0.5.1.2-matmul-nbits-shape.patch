diff --git a/src/Builder/FrontendDialectTransformer.cpp b/src/Builder/FrontendDialectTransformer.cpp
index 0d52996f..257bae64 100644
--- a/src/Builder/FrontendDialectTransformer.cpp
+++ b/src/Builder/FrontendDialectTransformer.cpp
@@ -786,6 +786,9 @@ private:
       // Optional outputs using empty string.
       if (node.output()[i].empty()) {
         outputTypes.emplace_back(builder_.getNoneType());
+      } else if (i < givenOutputTypes.size() &&
+                 mlir::isa<TensorType>(givenOutputTypes[i])) {
+        outputTypes.emplace_back(givenOutputTypes[i]);
       } else if (auto onnxModelType = ConvertOnnxType(node.output(i))) {
         outputTypes.emplace_back(onnxModelType.value());
       } else {
@@ -853,7 +856,10 @@ private:
       auto outTypes = opWithTypeInference.resultTypeInference();
       for (int i = 0; i < node.output().size(); i++) {
         OpResult result = op->getResult(i);

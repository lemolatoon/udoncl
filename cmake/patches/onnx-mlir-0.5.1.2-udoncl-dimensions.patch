+// SPDX-License-Identifier: Apache-2.0
+
+#include "src/Builder/FrontendDialectTransformer.hpp"
+#include "src/Compiler/CompilerDialects.hpp"
+#include "src/Dialect/ONNX/ONNXDialect.hpp"
+
+#include "mlir/Bytecode/BytecodeWriter.h"
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/AsmState.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/DialectRegistry.h"
+#include "mlir/IR/MLIRContext.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <optional>
+#include <regex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static std::optional<int64_t> evaluateDimension(
+    llvm::StringRef expression, const std::map<std::string, int64_t> &values) {
+  static const std::regex pattern(
+      R"(^\s*([A-Za-z_][A-Za-z0-9_.]*)(?:\s*\+\s*([0-9]+))?\s*$)");
+  std::smatch match;
+  std::string text = expression.str();
+  if (!std::regex_match(text, match, pattern))
+    return std::nullopt;
+  auto found = values.find(match[1].str());
+  if (found == values.end())
+    return std::nullopt;
+  int64_t offset = match[2].matched ? std::stoll(match[2].str()) : 0;
+  return found->second + offset;
+}
+
+static mlir::LogicalResult specializeInputs(mlir::ModuleOp module,
+    const std::map<std::string, int64_t> &values,
+    const std::map<std::string, std::vector<int64_t>> &inputShapes) {
+  for (auto function : module.getOps<mlir::func::FuncOp>()) {
+    std::vector<mlir::Type> inputs(
+        function.getArgumentTypes().begin(), function.getArgumentTypes().end());
+    for (unsigned index = 0; index < function.getNumArguments(); ++index) {
+      auto tensor = llvm::dyn_cast<mlir::RankedTensorType>(inputs[index]);
+      auto publicName =
+          function.getArgAttrOfType<mlir::StringAttr>(index, "onnx.name");
+      auto parameters =
+          function.getArgAttrOfType<mlir::StringAttr>(index, "onnx.dim_params");
+      if (!tensor)
+        continue;
+      std::vector<int64_t> shape(
+          tensor.getShape().begin(), tensor.getShape().end());
+      auto override = publicName ? inputShapes.find(publicName.getValue().str())
+                                 : inputShapes.end();
+      if (override != inputShapes.end()) {
+        if (override->second.size() != shape.size()) {
+          llvm::errs() << "udoncl-onnx: input shape rank mismatch for '"
+                       << publicName.getValue() << "'\n";
+          return mlir::failure();
+        }
+        shape = override->second;
+      } else if (parameters) {
+        llvm::SmallVector<llvm::StringRef> entries;
+        parameters.getValue().split(entries, ',');
+        for (llvm::StringRef entry : entries) {
+          auto pair = entry.split(':');
+          unsigned axis = 0;
+          if (pair.first.getAsInteger(10, axis) || axis >= shape.size()) {
+            llvm::errs() << "udoncl-onnx: invalid onnx.dim_params entry '"
+                         << entry << "'\n";
+            return mlir::failure();
+          }
+          std::optional<int64_t> value = evaluateDimension(pair.second, values);
+          if (value)
+            shape[axis] = *value;
+        }
+      }
+      inputs[index] = mlir::RankedTensorType::get(
+          shape, tensor.getElementType(), tensor.getEncoding());
+      function.getArgument(index).setType(inputs[index]);
+    }
+    function.setType(mlir::FunctionType::get(
+        module.getContext(), inputs, function.getResultTypes()));
+  }
+  return mlir::success();
+}
+
+int main(int argc, char **argv) {
+  if (argc < 2) {
+    llvm::errs() << "usage: udoncl-onnx input.onnx [-o output.mlir] [--dim "
+                    "name=value]\n";
+    return 2;
+  }
+  std::string outputPath;
+  std::map<std::string, int64_t> dimensions;
+  std::map<std::string, std::vector<int64_t>> inputShapes;
+  for (int index = 2; index < argc; ++index) {
+    std::string argument = argv[index];
+    if (argument == "-o" && index + 1 < argc) {
+      outputPath = argv[++index];
+      continue;
+    }
+    if (argument == "--dim" && index + 1 < argc) {
+      std::string value = argv[++index];
+      size_t separator = value.find('=');
+      if (separator == std::string::npos || separator == 0) {
+        llvm::errs() << "udoncl-onnx: expected --dim name=value\n";
+        return 2;
+      }
+      try {
+        int64_t parsed = std::stoll(value.substr(separator + 1));
+        if (parsed < 0 ||
+            !dimensions.emplace(value.substr(0, separator), parsed).second)
+          throw std::invalid_argument("invalid or duplicate dimension");
+      } catch (const std::exception &) {
+        llvm::errs() << "udoncl-onnx: invalid --dim value '" << value << "'\n";
+        return 2;
+      }
+      continue;
+    }
+    if (argument == "--input-shape" && index + 1 < argc) {
+      std::string value = argv[++index];
+      size_t separator = value.find('=');
+      if (separator == std::string::npos || separator == 0) {
+        llvm::errs() << "udoncl-onnx: expected --input-shape name=d0,d1,...\n";
+        return 2;
+      }
+      std::vector<int64_t> shape;
+      std::stringstream dimensionsText(value.substr(separator + 1));
+      std::string dimension;
+      try {
+        while (std::getline(dimensionsText, dimension, ',')) {
+          if (dimension.empty())
+            throw std::invalid_argument("empty dimension");
+          int64_t parsed = std::stoll(dimension);
+          if (parsed < 0)
+            throw std::invalid_argument("negative dimension");
+          shape.push_back(parsed);
+        }
+      } catch (const std::exception &) {
+        llvm::errs() << "udoncl-onnx: invalid --input-shape value '" << value
+                     << "'\n";
+        return 2;
+      }
+      if (shape.empty() ||
+          !inputShapes.emplace(value.substr(0, separator), shape).second) {
+        llvm::errs() << "udoncl-onnx: invalid or duplicate --input-shape '"
+                     << value << "'\n";
+        return 2;
+      }
+      continue;
+    }
+    llvm::errs() << "udoncl-onnx: unknown or incomplete argument '" << argument
+                 << "'\n";
+    return 2;
+  }
+
+  mlir::DialectRegistry registry = onnx_mlir::registerDialects({});
+  mlir::MLIRContext context(registry);
+  context.loadDialect<mlir::ONNXDialect, mlir::func::FuncDialect>();
+  mlir::OwningOpRef<mlir::ModuleOp> module;
+  std::string error;
+  onnx_mlir::ImportOptions options;
+  options.externalDataDir =
+      std::filesystem::absolute(argv[1]).parent_path().string();
+  int result = onnx_mlir::ImportFrontendModelFile(
+      argv[1], context, module, &error, options);
+  if (result != 0 || !module) {
+    llvm::errs() << "udoncl-onnx: " << error << "\n";
+    return result == 0 ? 1 : result;
+  }
+  if (mlir::failed(specializeInputs(*module, dimensions, inputShapes)))
+    return 1;
+
+  if (outputPath.empty()) {
+    mlir::OpPrintingFlags flags;
+    flags.enableDebugInfo();
+    module->print(llvm::outs(), flags);
+    llvm::outs() << "\n";
+    return 0;
+  }
+  std::error_code outputError;
+  llvm::raw_fd_ostream output(outputPath, outputError, llvm::sys::fs::OF_None);
+  if (outputError) {
+    llvm::errs() << "udoncl-onnx: cannot open " << outputPath << ": "
+                 << outputError.message() << "\n";
+    return 1;
+  }
+  return mlir::failed(mlir::writeBytecodeToFile(*module, output));
+}

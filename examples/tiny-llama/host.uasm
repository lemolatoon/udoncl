    .export _onAsyncGpuReadbackComplete
    _onAsyncGpuReadbackComplete:
        PUSH, onAsyncGpuReadbackCompleteRequest
        PUSH, readbackPixels
        PUSH, __zero
        PUSH, __readbackOk
        EXTERN, "VRCSDK3RenderingVRCAsyncGPUReadbackRequest.__TryGetData__UnityEngineColor32Array_SystemInt32__SystemBoolean"
        PUSH, __readbackOk
        JUMP_IF_FALSE, __readbackFailed
        PUSH, readbackPixels
        PUSH, __zero
        PUSH, __pixel
        EXTERN, "UnityEngineColor32Array.__Get__SystemInt32__UnityEngineColor32"
        PUSH, __pixel
        PUSH, __red
        EXTERN, "UnityEngineColor32.__get_r__SystemByte"
        PUSH, __red
        PUSH, __prediction
        EXTERN, "SystemConvert.__ToInt32__SystemByte__SystemInt32"
        PUSH, responseWords
        PUSH, __prediction
        PUSH, __reply
        EXTERN, "SystemStringArray.__Get__SystemInt32__SystemString"
        PUSH, sharedToken1
        PUSH, sharedToken0
        COPY
        PUSH, sharedToken2
        PUSH, sharedToken1
        COPY
        PUSH, sharedToken3
        PUSH, sharedToken2
        COPY
        PUSH, __prediction
        PUSH, sharedToken3
        COPY
        PUSH, __pendingHistory
        PUSH, __reply
        PUSH, sharedHistory
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, sharedTurn
        PUSH, __one
        PUSH, sharedTurn
        EXTERN, "SystemInt32.__op_Addition__SystemInt32_SystemInt32__SystemInt32"
        PUSH, historyText
        PUSH, sharedHistory
        EXTERN, "UnityEngineUIText.__set_text__SystemString__SystemVoid"
        PUSH, __receiver
        EXTERN, "VRCUdonCommonInterfacesIUdonEventReceiver.__RequestSerialization__SystemVoid"
        PUSH, __false
        PUSH, __waiting
        COPY
        JUMP, 0xFFFFFFFC

    __readbackFailed:
        PUSH, __false
        PUSH, __waiting
        COPY
        JUMP, 0xFFFFFFFC

    .export _onDeserialization
    _onDeserialization:
        JUMP, __refreshHistory

    __refreshHistory:
        PUSH, historyText
        PUSH, sharedHistory
        EXTERN, "UnityEngineUIText.__set_text__SystemString__SystemVoid"
    __end:
        JUMP, 0xFFFFFFFC
.code_end

.code_start
    .export _start
    _start:
        JUMP, __refreshHistory

    .export _interact
    _interact:
        PUSH, __waiting
        JUMP_IF_FALSE, __acceptPrompt
        JUMP, 0xFFFFFFFC

    __acceptPrompt:
        PUSH, promptInput
        PUSH, __prompt
        EXTERN, "UnityEngineUIInputField.__get_text__SystemString"
        PUSH, __prompt
        PUSH, __length
        EXTERN, "SystemString.__get_Length__SystemInt32"
        PUSH, __length
        JUMP_IF_FALSE, __end
        PUSH, __length
        PUSH, __length
        PUSH, __true
        EXTERN, "SystemInt32.__op_Equality__SystemInt32_SystemInt32__SystemBoolean"
        PUSH, __localPlayer
        EXTERN, "VRCSDKBaseNetworking.__get_LocalPlayer__VRCSDKBaseVRCPlayerApi"
        PUSH, __localPlayer
        PUSH, __gameObject
        EXTERN, "VRCSDKBaseNetworking.__SetOwner__VRCSDKBaseVRCPlayerApi_UnityEngineGameObject__SystemVoid"
        PUSH, __localPlayer
        PUSH, __playerName
        EXTERN, "VRCSDKBaseVRCPlayerApi.__get_displayName__SystemString"

        PUSH, sharedToken1
        PUSH, sharedToken0

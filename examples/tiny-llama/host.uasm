        EXTERN, "UnityEngineMaterial.__SetInt__SystemString_SystemInt32__SystemVoid"
        PUSH, packMaterial
        PUSH, __token3Name
        PUSH, sharedToken3
        EXTERN, "UnityEngineMaterial.__SetInt__SystemString_SystemInt32__SystemVoid"
        PUSH, packMaterial
        PUSH, __inputName
        PUSH, initialState
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, initialState
        PUSH, stateA
        PUSH, packMaterial
        EXTERN, "VRCSDKBaseVRCGraphics.__Blit__UnityEngineTexture_UnityEngineRenderTexture_UnityEngineMaterial__SystemVoid"
        PUSH, stateA
        PUSH, __source
        COPY

        PUSH, sharedHistory
        PUSH, __newline
        PUSH, __stringTemp
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, __stringTemp
        PUSH, __playerName
        PUSH, __pendingHistory
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, __pendingHistory
        PUSH, __separator
        PUSH, __stringTemp
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, __stringTemp
        PUSH, __prompt
        PUSH, __pendingHistory
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, __pendingHistory
        PUSH, __assistantPrefix
        PUSH, __stringTemp
        EXTERN, "SystemString.__op_Addition__SystemString_SystemString__SystemString"
        PUSH, __stringTemp
        PUSH, __pendingHistory
        COPY
        PUSH, promptInput
        PUSH, __empty
        EXTERN, "UnityEngineUIInputField.__set_text__SystemString__SystemVoid"
        PUSH, __true
        PUSH, __waiting
        COPY
        PUSH, __true
        PUSH, __runtimeDispatch
        COPY
        JUMP, __dispatchDevice

    .export _runDeviceFixture
    _runDeviceFixture:
        PUSH, initialState
        PUSH, __source
        COPY
        PUSH, __false
        PUSH, __runtimeDispatch
        COPY
        JUMP, __dispatchDevice

    __dispatchDevice:
        PUSH, embedMaterial
        PUSH, __inputName
        PUSH, __source
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, __source
        PUSH, stateB
        PUSH, embedMaterial
        EXTERN, "VRCSDKBaseVRCGraphics.__Blit__UnityEngineTexture_UnityEngineRenderTexture_UnityEngineMaterial__SystemVoid"
        PUSH, stateB
        PUSH, __source
        COPY
        PUSH, qkvMaterial
        PUSH, __inputName
        PUSH, __source
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, __source
        PUSH, stateA
        PUSH, qkvMaterial
        EXTERN, "VRCSDKBaseVRCGraphics.__Blit__UnityEngineTexture_UnityEngineRenderTexture_UnityEngineMaterial__SystemVoid"
        PUSH, stateA

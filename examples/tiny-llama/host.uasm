        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, __source
        PUSH, stateB
        PUSH, logitsMaterial
        EXTERN, "VRCSDKBaseVRCGraphics.__Blit__UnityEngineTexture_UnityEngineRenderTexture_UnityEngineMaterial__SystemVoid"
        PUSH, stateB
        PUSH, __source
        COPY
        PUSH, displayMaterial
        PUSH, __logitsName
        PUSH, __source
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, __runtimeDispatch
        JUMP_IF_FALSE, __end
        PUSH, argmaxMaterial
        PUSH, __logitsName
        PUSH, stateB
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, stateB

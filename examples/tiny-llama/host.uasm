        PUSH, stateA
        PUSH, __source
        COPY
        PUSH, ffnUpMaterial
        PUSH, __inputName
        PUSH, __source
        EXTERN, "UnityEngineMaterial.__SetTexture__SystemString_UnityEngineTexture__SystemVoid"
        PUSH, __source
        PUSH, stateB
        PUSH, ffnUpMaterial
        EXTERN, "VRCSDKBaseVRCGraphics.__Blit__UnityEngineTexture_UnityEngineRenderTexture_UnityEngineMaterial__SystemVoid"
        PUSH, stateB
        PUSH, __source
